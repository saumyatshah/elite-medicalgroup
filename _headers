# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# HSTS is intentionally NOT set here -- enable it in the Cloudflare dashboard
# (SSL/TLS > Edge Certificates > HSTS) once HTTPS is confirmed working, so the
# value lives in one place and can be rolled back from the dashboard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
